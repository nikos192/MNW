{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/lib/merchant/**/*.ts\" \"src/app/api/merchant-sync/route.ts\" \"scripts/merchant-sync.ts\" \"tests/merchant-sync.test.mts\" \"docs/google-merchant-sync.md\" \"vercel.json\" \".env.example\"",
    "format:check": "prettier --check \"src/lib/merchant/**/*.ts\" \"src/app/api/merchant-sync/route.ts\" \"scripts/merchant-sync.ts\" \"tests/merchant-sync.test.mts\" \"docs/google-merchant-sync.md\" \"vercel.json\" \".env.example\"",
    "test": "node --test --experimental-strip-types tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "merchant:sync": "tsx scripts/merchant-sync.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^1.7.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "shadcn": "^4.1.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
